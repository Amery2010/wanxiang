{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node"],
    "rootDir": ".",
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "workers/**/*.ts",
    "entries/**/*.ts",
    "scripts/**/*.mts",
    "entries/**/*.cts"
  ]
}
