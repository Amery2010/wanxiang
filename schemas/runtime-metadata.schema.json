{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"wx.runtime-metadata/1.0",
  "title":"Engine-neutral authored collision / LOD intent",
  "type":"object",
  "required":["schema","units","up","forward","collision"],
  "properties":{
    "schema":{"const":"wx.runtime-metadata/1.0"},"units":{"const":"m"},"up":{"const":"+Y"},"forward":{"const":"+Z"},
    "origin":{"type":"string"},"triangle_budget":{"type":"integer","minimum":1,"maximum":400000},
    "collision":{"$ref":"#/$defs/collision"},
    "lod":{"type":"object","properties":{"levels":{"type":"array","maxItems":3,"items":{"type":"object","required":["level","parameters"],"properties":{"level":{"type":"integer","minimum":0,"maximum":2},"parameters":{"type":"object"},"screen_height":{"type":"number","exclusiveMinimum":0,"maximum":1}}}}}}
  },
  "$defs":{"vector":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"number"}},"collision":{"type":"object","required":["type"],"properties":{"type":{"enum":["none","box","sphere","capsule","convex-hull","compound","authored-mesh","heightfield","children"]},"static_only":{"type":"boolean"},"size":{"$ref":"#/$defs/vector"},"center":{"$ref":"#/$defs/vector"},"radius":{"type":"number","exclusiveMinimum":0},"shapes":{"type":"array","minItems":1,"maxItems":128,"items":{"$ref":"#/$defs/collision"}}}}},
  "$comment":"Validate resolved numeric metadata, not unevaluated author expressions. Production validators additionally check axes, positive box dimensions, static concave proxies and unique LOD levels. This is not a physics engine scene."
}
