{
 "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"wx.interface-port/1.0","title":"Metre-space versioned module connector","type":"object",
 "required":["id","interface","position","normal","tangent"],
 "properties":{"id":{"type":"string","minLength":1},"interface":{"type":"string","pattern":"^[a-z][a-z0-9_.-]*\\.v[0-9]+$"},"version":{"const":1},"units":{"const":"m"},"position":{"$ref":"#/$defs/vector"},"normal":{"$ref":"#/$defs/vector"},"tangent":{"$ref":"#/$defs/vector"},"gender":{"enum":["neutral","male","female"]},"allowed_scale":{"enum":["none","uniform"]},"span":{"type":"number","exclusiveMinimum":0},"gauge":{"type":"number","exclusiveMinimum":0},"diameter":{"type":"number","exclusiveMinimum":0},"tolerance":{"type":"number","exclusiveMinimum":0},"profile":{"type":"array","minItems":2,"items":{"type":"number"}}},
 "$defs":{"vector":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"number"}}},
 "$comment":"The registry defines supported interface IDs and version-specific semantics. Production mating also verifies unit/orthogonal axes, matching profile dimensions and world-scale policy. Legacy unversioned generic ports are intentionally outside this schema."
}
