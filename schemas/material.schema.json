{
  "$id": "urn:wanxiang:material:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "channels": {
      "additionalProperties": {
        "properties": {
          "colorspace": {
            "enum": [
              "sRGB",
              "linear"
            ]
          },
          "file": {
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          }
        },
        "required": [
          "file",
          "sha256",
          "colorspace"
        ],
        "type": "object"
      },
      "required": [
        "basecolor"
      ],
      "type": "object"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$",
      "type": "string"
    },
    "schema": {
      "const": "wx.material/1.0"
    },
    "source": {
      "type": "object"
    }
  },
  "required": [
    "schema",
    "id",
    "source",
    "channels"
  ],
  "type": "object"
}
